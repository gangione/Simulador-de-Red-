{
  "name": "simulador-redes",
  "version": "4.0.0",
  "description": "Simulador de Laboratorio de Redes y Ciberseguridad - EEST N°10",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/ensure-electron-entry.mjs && tsc -p tsconfig.server.json",
    "dev": "vite",
    "prebuild": "node scripts/ensure-electron-entry.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "electron .",
    "start:server": "node server-dist/gameServer.js --port 7331",
    "package": "npm run build && electron-builder --win"
  },
  "author": "Soto Diego - Gareca Cristian",
  "license": "ISC",
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.tecnica10.simulador",
    "productName": "Simulador de Redes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "server-dist",
        "to": "server",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "node_modules/ws",
        "to": "server/node_modules/ws"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "secure-sonetcyber-game.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
