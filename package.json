{
  "name": "simulador-redes",
  "version": "4.0.0",
  "description": "Simulador de Laboratorio de Redes y Ciberseguridad - EEST N°10",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/ensure-electron-entry.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-electron-entry.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win"
  },
  "author": "Soto Diego - Gareca Cristian",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.tecnica10.simulador",
    "productName": "Simulador de Redes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
